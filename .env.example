# Copy to .env.local for local development. All values are optional for the demo.

# Used to sign login cookies. Set a long random value in production
# (e.g. run: openssl rand -base64 48).
SESSION_SECRET=

# Upstash Redis (added automatically by Vercel when you connect an Upstash store).
# Without these, the app stores data in ./.data locally, or temporarily in /tmp on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
